# ============================================================
# Samiksha AI Agent — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# --- Sarvam AI (Speech-to-Text) ---
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_ENDPOINT=https://api.sarvam.ai/speech-to-text

# --- LLM Provider ---
# Choose: "openai" | "local" | "mock"
# Use "mock" for offline testing of tools without any API key or credits
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o

# --- Local TTS Service (your Text_To_speech_api repo) ---
# URL where your TTS FastAPI server is running
TTS_API_URL=http://localhost:8000
TTS_VOICE=nova
TTS_MODEL=tts-1

# --- Audio Settings ---
# Sample rate for microphone recording (Hz)
MIC_SAMPLE_RATE=16000
# Max seconds to record per utterance
MIC_MAX_DURATION=10

# --- Memory (SQLite) ---
MEMORY_DB_PATH=./data/samiksha.db

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=./logs/samiksha.log

# --- Security ---
# Comma-separated list of tools that need confirmation before running
CONFIRMATION_REQUIRED_TOOLS=delete_file,move_file,shutdown_computer,restart_computer,execute_shell,send_email
